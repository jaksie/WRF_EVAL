////////////////////////////////////////////////////////////////////////
//
// PointStat_TMP_v2.conf
//
// MET Point-Stat configuration for WRF T2 vs IMGW TMP observations.
//
// This file is read by the MET executable point_stat.
// The WRF time index is injected from METplus through WRF_TIME_INDEX.
//
////////////////////////////////////////////////////////////////////////

model  = "WRF";
desc   = "WRF_T2_vs_IMGW_TMP";
obtype = "IMGW_ASCII2NC";

fcst = {
   field = [
      {
         name       = "T2";
         level      = [ "(${WRF_TIME_INDEX},*,*)" ];
         cat_thresh = [];
      }
   ];
}

obs = {
   field = [
      {
         name       = "TMP";
         level      = [ "Z2" ];
         cat_thresh = [];
      }
   ];
}

message_type = [ "ADPSFC" ];

obs_window = {
   beg = 0;
   end = 0;
}

mask = {
   grid = [ "FULL" ];
   poly = [];
}

interp = {
   type = {
      method = NEAREST;
      width  = 1;
   }
   vld_thresh = 1.0;
   shape      = SQUARE;
}

climo_mean = {
   file_name = [];
}

climo_stdev = {
   file_name = [];
}

output_flag = {
   fho    = NONE;
   ctc    = NONE;
   cts    = NONE;
   mctc   = NONE;
   mcts   = NONE;

   cnt    = BOTH;
   sl1l2  = BOTH;
   sal1l2 = NONE;
   vl1l2  = NONE;
   val1l2 = NONE;

   pct    = NONE;
   pstd   = NONE;
   pjc    = NONE;
   prc    = NONE;

   eclv   = NONE;

   mpr    = BOTH;
}

duplicate_flag = NONE;

sid_inc = [];
sid_exc = [];

obs_quality = {
   inc = [];
   exc = [];
}

ci_alpha = [ 0.05 ];

boot = {
   interval = PCTILE;
   rep_prop = 1.0;
   n_rep    = 0;
   rng      = "mt19937";
   seed     = "";
}

mpr_column  = [];
mpr_thresh  = [];
mpr_str_inc = [];
mpr_str_exc = [];

output_prefix = "wrf_t2_imgw_tmp";

////////////////////////////////////////////////////////////////////////////////
