<plot_spec>
    <!-- Python backend, standard Series plot: Y1 statistics and ME on the right Y2 axis. R-style vectors and template identifier belong to METviewer XML syntax. -->
    <connection>
        <host>mariadb</host>
        <database>mv_wrf_surface</database>
        <user>******</user>
        <password>******</password>
        <management_system>mariadb</management_system>
    </connection>
    <folders>
        <r_tmpl>/opt/tomcat/webapps/metviewer//R_tmpl</r_tmpl>
        <r_work>/opt/tomcat/webapps/metviewer//R_work</r_work>
        <plots>/opt/tomcat/webapps/metviewer_output//plots</plots>
        <data>/opt/tomcat/webapps/metviewer_output//data</data>
        <scripts>/opt/tomcat/webapps/metviewer_output//scripts</scripts>
    </folders>
    <plot>
        <template>series_plot.R_tmpl</template>
        <dep>
            <dep1>
                <fcst_var name="T2">
                    <stat>FBAR</stat>
                    <stat>OBAR</stat>
                </fcst_var>
            </dep1>
            <dep2>
                <fcst_var name="T2">
                    <stat>ME</stat>
                </fcst_var>
            </dep2>
        </dep>
        <series1>
            <field name="model">
                <val>WRF</val>
            </field>
        </series1>
        <series2>
            <field name="model">
                <val>WRF</val>
            </field>
        </series2>
        <plot_fix>
            <field equalize="false" name="model">
                <set name="model_0">
                    <val>WRF</val>
                </set>
            </field>
            <field equalize="false" name="vx_mask">
                <set name="vx_mask_0">
                    <val>FULL</val>
                </set>
            </field>
        </plot_fix>
        <plot_cond />
